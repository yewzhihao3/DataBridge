# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
*.whl
MANIFEST

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/

# ── Secrets and local configuration ──────────────────────────────────────────
# Never commit real environment files. Copy .env.example → .env locally.
.env
*.env
!.env.example

# ── Database files ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Uploaded files ────────────────────────────────────────────────────────────
# The uploads/ directory exists in version control (via .gitkeep) but its
# contents (real user uploads) must never be committed.
backend/uploads/*
!backend/uploads/.gitkeep

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
.next/
.nuxt/
.output/

# ── IDEs and editors ──────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
