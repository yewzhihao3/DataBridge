# .env.example — Environment variable template.
#
# Copy this file to .env before running the application:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# The real .env file is listed in .gitignore and must never be committed to Git.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── File uploads ──────────────────────────────────────────────────────────────
# Directory where uploaded files are stored (relative to backend/).
# This directory must exist. The .gitkeep file inside uploads/ creates it.
UPLOAD_DIR=uploads

# Maximum file size accepted by the upload endpoint, in megabytes.
MAX_FILE_SIZE_MB=10

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for local development. Switch to PostgreSQL for production:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/databridge
DATABASE_URL=sqlite:///./databridge.db

# Browser app origin (exact origin; invitations use this URL).
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Development only: an exact comma-separated public origin allowlist for a
# temporary tunnel. Do not set this in production.
# DEV_PUBLIC_ORIGINS=https://your-tunnel.ngrok-free.dev
# Set FRONTEND_URL to the same public origin when invitation links should open
# through that tunnel.
# Must be true with APP_ENV=production and HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=24
